# Project configuration
APP_NAME=LingLearn Cloud API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8003

# Logging and database
LOG_LEVEL=INFO
CORS_ORIGINS=*
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/linglearn_cloud
DB_ECHO=false
DB_POOL_RECYCLE=3600
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0  # REDIS_URL=redis://:你的密码@远程IP:6379/0
REDIS_PREFIX=linglearn
REDIS_DEFAULT_TTL_SECONDS=300

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM Configuration
# 使用 ModelScope DeepSeek API
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_TIMEOUT_SECONDS=60
# Email password reset
EMAIL_ENABLED=false
EMAIL_PROVIDER=aliyun
EMAIL_API_KEY=your-email-api-key
EMAIL_SECRET_KEY=your-email-secret-key
EMAIL_SENDER_EMAIL=your-sender@example.com
EMAIL_SENDER_NAME=LingLearn Cloud
EMAIL_TEST_EMAIL=your-test-recipient@example.com
EMAIL_TEST_MODE=false
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_DAILY_ACCOUNT_LIMIT=5
PASSWORD_RESET_DAILY_IP_LIMIT=20


# Video content agent
VIDEO_AUDIO_API_KEY=
VIDEO_AUDIO_MODEL=qwen3-omni-30b-a3b-captioner
VIDEO_AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AUDIO_TIMEOUT_SECONDS=120

VIDEO_VISION_API_KEY=
VIDEO_VISION_MODEL=Qwen/Qwen3.5-122B-A10B
VIDEO_VISION_BASE_URL=https://api-inference.modelscope.cn/v1
VIDEO_VISION_TIMEOUT_SECONDS=120

VIDEO_EXTRACT_MAX_FRAMES=6
VIDEO_EXTRACT_INTERVAL_SECONDS=20
VIDEO_EXTRACT_AUDIO_FORMAT=mp3

# MinIO
MINIO_ENDPOINT=47.109.194.175:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=linglearn-cloud
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=
MINIO_PRESIGN_EXPIRE_SECONDS=3600
MINIO_AUTO_CREATE_BUCKET=true

DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
